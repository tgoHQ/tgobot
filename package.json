{
	"name": "tgobot",
	"main": "dist/bot.js",
	"source": "src/bot.ts",
	"repository": "https://github.com/tgoHQ/tgobot",
	"packageManager": "pnpm@10.24.0",
	"scripts": {
		"build": "rm -rf dist && tsc",
		"watch": "tsc --watch --preserveWatchOutput",
		"start": "node .",
		"dev": "pnpm build && concurrently -k -n tsc,bot -c blue,green \"npm:watch\" \"npm:start\"",
		"check": "pnpm format && pnpm types && pnpm knip",
		"types": "tsc --noEmit",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"db": "drizzle-kit",
		"knip": "knip --treat-config-hints-as-errors"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "^4.0.90",
		"@openbeta/sandbag": "^0.0.55",
		"@sapphire/framework": "^5.5.1",
		"@sapphire/plugin-hmr": "^3.0.2",
		"@url-sanitize/clearurls": "^2.0.4",
		"@url-sanitize/core": "^2.0.4",
		"ai": "^7.0.155",
		"clean-links": "^0.0.7",
		"discord.js": "^14.27.0",
		"drizzle-orm": "^0.45.4",
		"humanize-duration": "^3.35.0",
		"node-cron": "^4.6.0",
		"parse-duration": "^2.1.10",
		"postgres": "^3.4.9",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/humanize-duration": "^3.27.4",
		"@types/node": "^26.6.5",
		"concurrently": "^10.0.6",
		"dotenv": "^18.0.9",
		"drizzle-kit": "^0.31.11",
		"knip": "^6.43.0",
		"prettier": "^3.9.10",
		"typescript": "^7.0.2"
	},
	"type": "module",
	"imports": {
		"#*": "./dist/*.js"
	}
}
